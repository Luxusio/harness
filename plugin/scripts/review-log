#!/usr/bin/env python3
"""Store one exact formal-review final in the selected task detail store."""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _lib import (  # noqa: E402
    _REVIEW_DETAIL_MAX_BYTES,
    append_review_detail,
    canonical_task_dir,
    find_harness_root,
    find_repo_root,
    read_task_control,
    resolve_active_task_dir,
)


def _task_dir(parser, value):
    repo_root = find_harness_root() or find_repo_root()
    try:
        task_dir = (
            canonical_task_dir(task_dir=value, repo_root=repo_root)
            if value else resolve_active_task_dir(repo_root)
        )
    except ValueError as exc:
        parser.error(str(exc))
    if not task_dir:
        parser.error("no active task; pass --task-dir TASK_DIR")
    if not read_task_control(task_dir):
        parser.error("selected task requires a valid TASK.json")
    return task_dir


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Store one exact review final and print its content digest.",
    )
    parser.add_argument("--task-dir", help="canonical task directory; defaults to active task")
    args = parser.parse_args(argv)
    task_dir = _task_dir(parser, args.task_dir)
    raw = sys.stdin.buffer.read(_REVIEW_DETAIL_MAX_BYTES + 1)
    if not raw:
        parser.error("review detail must not be empty")
    if len(raw) > _REVIEW_DETAIL_MAX_BYTES:
        parser.error("review detail exceeds the 2 MiB limit")
    try:
        detail = raw.decode("utf-8")
    except UnicodeDecodeError:
        parser.error("review detail must be valid UTF-8 text")
    try:
        digest = append_review_detail(task_dir, detail)
    except ValueError as exc:
        parser.error(str(exc))
    except RuntimeError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 4
    print(f"DETAIL_SHA256:{digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
