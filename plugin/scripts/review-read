#!/usr/bin/env python3
"""Read exactly one task-local formal-review final by SHA-256 digest."""

import argparse
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _lib import (  # noqa: E402
    canonical_task_dir,
    find_harness_root,
    find_repo_root,
    read_review_detail,
    read_task_control,
    resolve_active_task_dir,
)


def _task_dir(parser, value):
    repo_root = find_harness_root() or find_repo_root()
    try:
        task_dir = (
            canonical_task_dir(task_dir=value, repo_root=repo_root)
            if value else resolve_active_task_dir(repo_root)
        )
    except ValueError as exc:
        parser.error(str(exc))
    if not task_dir:
        parser.error("no active task; pass --task-dir TASK_DIR")
    if not read_task_control(task_dir):
        parser.error("selected task requires a valid TASK.json")
    return task_dir


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Print one exact review final; never list or dump the detail store.",
    )
    parser.add_argument("--task-dir", help="canonical task directory; defaults to active task")
    parser.add_argument("digest", help="64-character lowercase SHA-256 digest")
    args = parser.parse_args(argv)
    if re.fullmatch(r"[0-9a-f]{64}", args.digest) is None:
        parser.error("digest must be 64 lowercase hexadecimal characters")
    task_dir = _task_dir(parser, args.task_dir)
    try:
        detail = read_review_detail(task_dir, args.digest)
    except FileNotFoundError:
        print(
            "ERROR: review detail not found; its receipt may predate stored detail",
            file=sys.stderr,
        )
        return 3
    except RuntimeError:
        print("ERROR: review detail storage integrity unavailable", file=sys.stderr)
        return 4
    sys.stdout.buffer.write(detail.encode("utf-8"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
