{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import subprocess, os; branch=subprocess.run(['git','branch','--show-current'],capture_output=True,text=True,cwd=os.getcwd()).stdout.strip() or 'unknown'; project=os.path.basename(os.getcwd()); print(f'harness \u2014 ready.\\nProject: {project}  Branch: {branch}\\nLoop: goal \u2192 task \u2192 verify \u2192 close\\nAuto-routing on. Just describe what you want.\\nREQ: capture requirements as doc/<area>/REQ__<slug>.md when behavior changes.')\" || true",
            "timeout": 5,
            "statusMessage": "harness ready"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/note_freshness.py --from-git 1 --quiet || true",
            "timeout": 5,
            "statusMessage": "Checking note freshness"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/verification_gap_check.py || true",
            "timeout": 5,
            "statusMessage": "Checking verification gaps"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/drift_warn.py || true",
            "timeout": 5,
            "statusMessage": "Checking installed plugin drift"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/stop_gate.py || true",
            "timeout": 10,
            "statusMessage": "Checking open tasks"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/background_hook.py --event start || true",
            "timeout": 3,
            "statusMessage": "Tracking background agent"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/background_hook.py --event stop || true",
            "timeout": 3,
            "statusMessage": "Tracking background agent completion"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/prewrite_gate.py || true",
            "timeout": 3,
            "statusMessage": "Checking write gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/mcp_bash_guard.py || true",
            "timeout": 3,
            "statusMessage": "Checking bash mutation guard"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/qa_delegation_gate.py || true",
            "timeout": 3,
            "statusMessage": "Checking MCP verification delegation (C-18)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/prompt_memory.py || true",
            "timeout": 3,
            "statusMessage": "Injecting task context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/tool_routing.py || true",
            "timeout": 3,
            "statusMessage": "Routing hint on bash failures"
          }
        ]
      }
    ]
  }
}
