{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_session_start.py\" --claude-banner || true",
            "timeout": 5,
            "statusMessage": "harness ready"
          },
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ${CLAUDE_PLUGIN_ROOT}/scripts/verification_gap_check.py || true",
            "timeout": 5,
            "statusMessage": "Checking verification gaps"
          },
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ${CLAUDE_PLUGIN_ROOT}/scripts/project_format_check.py || true",
            "timeout": 5,
            "statusMessage": "Checking Harness project format"
          },
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ${CLAUDE_PLUGIN_ROOT}/scripts/drift_warn.py || true",
            "timeout": 5,
            "statusMessage": "Checking installed plugin drift"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ${CLAUDE_PLUGIN_ROOT}/scripts/prewrite_gate.py || true",
            "timeout": 10,
            "statusMessage": "Checking write gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ${CLAUDE_PLUGIN_ROOT}/scripts/prompt_memory.py || true",
            "timeout": 3,
            "statusMessage": "Injecting task context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ${CLAUDE_PLUGIN_ROOT}/scripts/tool_routing.py || true",
            "timeout": 3,
            "statusMessage": "Routing hint on bash failures"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_harness_harness__wbs|mcp__harness__wbs",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONDONTWRITEBYTECODE=1 python3 ${CLAUDE_PLUGIN_ROOT}/scripts/hook_post_tool_use.py || true",
            "timeout": 10,
            "statusMessage": "Binding exact task focus"
          }
        ]
      }
    ]
  }
}
