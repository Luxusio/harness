{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os; project=os.path.basename(os.getcwd()); print(f'harness \u2014 ready.\\nProject: {project}\\nLoop: task start \u2192 plan \u2192 develop \u2192 QA \u2192 close\\nReview and task_verify run as internal close gates.\\nAuto-routing on. Just describe what you want.\\nREQ: capture requirements as doc/<area>/REQ__<slug>.md when behavior changes.')\" || true",
            "timeout": 5,
            "statusMessage": "harness ready"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/verification_gap_check.py || true",
            "timeout": 5,
            "statusMessage": "Checking verification gaps"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/drift_warn.py || true",
            "timeout": 5,
            "statusMessage": "Checking installed plugin drift"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/stop_gate.py || true",
            "timeout": 10,
            "statusMessage": "Checking open tasks"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/background_hook.py --event start || true",
            "timeout": 3,
            "statusMessage": "Tracking background agent"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/background_hook.py --event stop || true",
            "timeout": 3,
            "statusMessage": "Tracking background agent completion"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/prewrite_gate.py || true",
            "timeout": 3,
            "statusMessage": "Checking write gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/prompt_memory.py || true",
            "timeout": 3,
            "statusMessage": "Injecting task context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/tool_routing.py || true",
            "timeout": 3,
            "statusMessage": "Routing hint on bash failures"
          }
        ]
      }
    ]
  }
}
