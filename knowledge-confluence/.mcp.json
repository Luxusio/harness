{
  "mcpServers": {
    "confluence": {
      "command": "python3",
      "args": [
        "-I",
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch.py"
      ],
      "env_vars": [
        "HOME",
        "JAVA_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "KNOWLEDGE_CONFLUENCE_CONFIG",
        "KNOWLEDGE_CONFLUENCE_JAVA",
        "JIRA_EMAIL",
        "JIRA_API_TOKEN"
      ]
    }
  }
}

