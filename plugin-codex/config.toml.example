# Codex CLI config block for the harness plugin.
#
# This file is an example only. `python3 install.py --codex-only` writes the
# real paths for your machine and backs up an existing config before replacing
# a previous harness block.
#
# Hooks are NOT installed here. Codex loads harness hooks from the plugin-local
# `hooks.json` generated under `~/.codex/harness/plugins/harness/`.

[plugins."harness@harness"]
enabled = true

[mcp_servers.harness]
command = "/home/you/.local/share/mise/installs/python/3.12.15/bin/python3.12"
args = ["-E", "-s", "-B", "/home/you/.codex/harness/plugins/harness/mcp/harness_server.py"]
env = { HARNESS_PLUGIN_ROOT = "/home/you/.codex/harness/plugins/harness", CLAUDE_PLUGIN_ROOT = "/home/you/.codex/harness/plugins/harness", HARNESS_RUNTIME = "codex", PYTHONDONTWRITEBYTECODE = "1" }
startup_timeout_sec = 10
tool_timeout_sec = 60
enabled = true
required = false

# Optional: load CLAUDE.md as fallback project doc during migration.
project_doc_fallback_filenames = ["CLAUDE.md", "AGENTS.md"]
project_doc_max_bytes = 32768
