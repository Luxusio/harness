{
  "mcpServers": {
    "atlassian": {
      "command": "mise",
      "args": [
        "exec",
        "python@3.12",
        "--",
        "python",
        "-I",
        "-B",
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch.py",
        "--mise"
      ],
      "env_vars": [
        "HOME",
        "USERPROFILE",
        "APPDATA",
        "LOCALAPPDATA",
        "SystemRoot",
        "PATH",
        "TEMP",
        "TMP",
        "ATLASSIAN_EMAIL",
        "ATLASSIAN_API_TOKEN",
        "ATLASSIAN_BASE_URL"
      ],
      "env": {
        "MISE_AUTO_INSTALL": "0"
      }
    }
  }
}
