{
  "mcpServers": {
    "atlassian": {
      "command": "python",
      "args": [
        "-I",
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch.py"
      ],
      "env_vars": [
        "HOME",
        "USERPROFILE",
        "APPDATA",
        "LOCALAPPDATA",
        "SystemRoot",
        "PATH",
        "TEMP",
        "TMP",
        "ATLASSIAN_EMAIL",
        "ATLASSIAN_API_TOKEN",
        "ATLASSIAN_BASE_URL"
      ]
    }
  }
}
